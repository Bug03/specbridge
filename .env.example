# Copy this file to .env and fill it in. Use a Jira account with read-only project access.
SPECBRIDGE_JIRA_BASE_URL=https://your-domain.atlassian.net
SPECBRIDGE_JIRA_EMAIL=you@example.com
SPECBRIDGE_JIRA_API_TOKEN=

# Defaults used by `node src/cli.js context`.
SPECBRIDGE_JIRA_ISSUE=PROJ-123
SPECBRIDGE_REPOSITORY_ROOT=.
SPECBRIDGE_SPEC_FILE=openspec/specs/your-spec/spec.md
SPECBRIDGE_SPEC_HEADING=Requirement: Replace with the exact heading
