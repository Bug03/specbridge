# Copy this file to .env and fill it in. Use a Jira account with read-only project access.
SPECBRIDGE_JIRA_BASE_URL=https://your-domain.atlassian.net
SPECBRIDGE_JIRA_EMAIL=you@example.com
SPECBRIDGE_JIRA_API_TOKEN=

# Optional. By default SpecBridge scans the current directory for OpenSpec.
# Set this only when running the command from another directory.
# SPECBRIDGE_REPOSITORY_ROOT=/path/to/your/project
